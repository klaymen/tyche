#!/usr/bin/env python3
"""Git pre-commit hook: auto-bump the patch component of VERSION in manloading_report.py."""
import re
import subprocess
from pathlib import Path

REPO_ROOT = Path(
    subprocess.run(["git", "rev-parse", "--show-toplevel"],
                   capture_output=True, text=True, check=True).stdout.strip()
)
TARGET = REPO_ROOT / "manloading_report.py"

text = TARGET.read_text(encoding="utf-8")
match = re.search(r'^VERSION\s*=\s*"(\d+)\.(\d+)\.(\d+)"', text, re.MULTILINE)
if not match:
    print("[pre-commit] WARNING: VERSION not found in manloading_report.py — skipping bump")
else:
    major, minor, patch = int(match.group(1)), int(match.group(2)), int(match.group(3))
    new_version = f"{major}.{minor}.{patch + 1}"
    new_text = re.sub(
        r'^(VERSION\s*=\s*)"(\d+\.\d+\.\d+)"',
        lambda m: f'{m.group(1)}"{new_version}"',
        text,
        flags=re.MULTILINE,
    )
    TARGET.write_text(new_text, encoding="utf-8")
    subprocess.run(["git", "add", str(TARGET)], check=True)
    print(f"[pre-commit] VERSION bumped to {new_version}")
